          "name": "List all flags for an environment",
          "request": {
            "name": "List all flags for an environment",
            "description": {
              "content": "Retrieves all feature flags for the environment associated with the provided Environment Key. Returns an array of flag objects, each containing the feature definition, its enabled state, and any associated value. This endpoint is used by client-side SDKs to initialize flag state.",
              "type": "text/plain"
            },
            "url": {
