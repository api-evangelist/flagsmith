                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "feature",
                  "value": "<string>",
                  "description": "Optional feature name to filter flags. When provided, returns only the flag matching the specified feature name."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
